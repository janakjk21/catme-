# Keep the downloaded SDK archive outside source control; imported packages live in Assets.
/firebase_unity_sdk_*.zip
# Local-only packaged development cat
/Assets/StreamingAssets/Cats/*.glb
# Local prototype provider credentials; intentionally embedded only in local builds
/Assets/Resources/CompanionProviderKeys.json
/Assets/Resources/CompanionProviderKeys.json.meta

# Private credentials are retained outside Unity import/build paths.
/.local-private/

# Firebase desktop/Editor native libraries (reinstall from the Firebase Unity SDK)
/Assets/Firebase/Plugins/x86_64/
/Assets/Firebase/Plugins/x86_64.meta

# Firebase project config (keep local; this repo is public)
GoogleService-Info.plist
google-services.jsontools/asset_used.txt
